{
  "name": "plataforma-barberias-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de la plataforma SaaS de barberías (monolito modular NestJS)",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "migrate": "tsx src/shared/persistence/migrate.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest --config jest.config.ts",
    "test:int": "jest --config jest.int.config.ts --runInBand",
    "test:arch": "depcruise src migrations --config .dependency-cruiser.cjs && jest --config jest.arch.config.ts",
    "medir:horarios": "tsx scripts/medir-horarios.ts",
    "demo:caida": "tsx scripts/demo-caida.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "ioredis": "5.4.2",
    "jose": "5.10.0",
    "kysely": "0.28.17",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.6.0",
    "eslint": "9.39.5",
    "jest": "29.7.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "yaml": "2.9.1"
  }
}
