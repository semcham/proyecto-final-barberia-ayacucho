# Copiar a .env (no versionado). Valores SOLO para desarrollo local.

# Puerto con el que Docker Compose publica PostgreSQL en este equipo (por defecto 5433, para no chocar con
# un PostgreSQL instalado localmente en el 5432). Dentro de la red de Compose la base siempre es db:5432.
DB_PUERTO=5433

# Vite (contenedor frontend) revisa los archivos cada 300 ms porque en Windows y macOS el volumen montado no
# avisa los cambios. En Linux se puede poner false para ahorrar CPU.
VITE_SONDEO=true

# Conexiones a PostgreSQL. La aplicación usa barberias_app (NOBYPASSRLS); las migraciones, barberias_owner.
# Sirven para ejecutar el backend o las migraciones desde el equipo contra la base de Compose (usar el
# mismo puerto que DB_PUERTO). Dentro de Docker Compose se sobrescriben con el host "db" (docker-compose.yml).
DATABASE_URL_APP=postgres://barberias_app:barberias_app_dev@localhost:5433/barberias
DATABASE_URL_OWNER=postgres://barberias_owner:barberias_owner_dev@localhost:5433/barberias
# Vía pública por enlace (catálogo y horarios libres, ADR-021): rol barberias_publico, sin BYPASSRLS y solo
# con SELECT sobre columnas públicas, en transacciones de solo lectura.
DATABASE_URL_PUBLICO=postgres://barberias_publico:barberias_publico_dev@localhost:5433/barberias

# Horarios libres (R08): paso entre horas de inicio, en minutos (divisor de 60, de 5 a 60), y cuántos días
# hacia adelante se puede reservar (de 1 a 90). Propuestas por validar con las barberías.
HORARIOS_PASO_MINUTOS=15
RESERVA_HORIZONTE_DIAS=30

# Firma del token de acceso (ES256, R07).
# Generar un par de claves de desarrollo:
#   openssl ecparam -name prime256v1 -genkey -noout -out privada.pem
#   openssl pkcs8 -topk8 -nocrypt -in privada.pem -out privada-pkcs8.pem
#   openssl ec -in privada.pem -pubout -out publica.pem
# Pegar los PEM en una sola línea reemplazando los saltos de línea por \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Claves públicas aceptadas al verificar, por kid (permite rotar claves sin cambiar código).
JWT_PUBLIC_KEYS={"dev-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
JWT_ACTIVE_KID=dev-1
JWT_ISSUER=plataforma-barberias
JWT_AUDIENCE=plataforma-barberias-web
ACCESS_TOKEN_TTL_SECONDS=900
# Período de gracia de la rotación del token de renovación (FR-008a, ADR-019): el token anterior se acepta
# una sola vez durante estos segundos tras la rotación (recarga doble, respuesta perdida). De 0 a 30; 0 lo
# desactiva y cualquier reutilización revoca la sesión.
REFRESH_GRACIA_SEGUNDOS=10

# Argon2id (R06): mínimo recomendado por OWASP.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Origen permitido por CORS y URL base para los enlaces de activación.
CORS_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Versiones vigentes de los textos que acepta el propietario al registrarse (FR-005).
TERMS_VERSION=2026-10
PRIVACY_POLICY_VERSION=2026-10

# Registros de barbería permitidos por IP y minuto (POST /barberias).
REGISTRO_LIMITE_POR_MINUTO=10
# Intentos de activación de cuenta por IP y minuto (POST /auth/activar).
ACTIVACION_LIMITE_POR_MINUTO=10
# Solicitudes a la vía pública por enlace por IP y minuto (GET /publico/*, ADR-021).
PUBLICO_LIMITE_POR_MINUTO=120

PORT=3000

# --- Funcionalidad 006: caché compartida, límites compartidos y balanceo (ADR-029, ADR-030) ---

# Redis (caché del catálogo público y contadores del límite general por IP). Desde el equipo, el Redis de
# Compose se publica en REDIS_PUERTO; dentro de Compose las réplicas usan su IP fija (IP_REDIS). Sin valor, el
# backend funciona igual: sin caché y con el límite de solicitudes por instancia (principio VIII).
REDIS_URL=redis://localhost:6380
REDIS_PUERTO=6380
# Caché del catálogo público por barbería: true o false (false para medir sin caché).
CACHE_CATALOGO_ACTIVA=true
# Caché de horarios calculados (FR-013b): solo si la medición lo exige. Por defecto, false.
CACHE_HORARIOS_ACTIVA=false
# Tiempo máximo de vida de la entrada del catálogo, en segundos (de 10 a 300).
CACHE_CATALOGO_TTL_SEGUNDOS=120
# Tiempo límite de cada operación con Redis, en milisegundos (de 10 a 1000).
CACHE_TIMEOUT_MS=100
# Interruptor: fallos seguidos para dejar de usar Redis (de 1 a 50) y pausa antes de reintentar (ms).
CACHE_FALLOS_PARA_ABRIR=5
CACHE_PAUSA_MS=10000

# Proxies de confianza para tomar la IP del cliente de X-Forwarded-For (trust proxy de Express). En local,
# loopback. Docker Compose la fija a la IP de Nginx; nunca usar una red privada completa.
PROXIES_CONFIABLES=loopback
# Nombre lógico de la réplica (encabezado X-Instancia). Lo fija Docker Compose; vacío en local.
INSTANCIA_ID=
# Conexiones máximas de los pools del rol de la aplicación y del rol público (de 2 a 50).
DB_POOL_APP_MAX=10
DB_POOL_PUBLICO_MAX=10

# Red de Docker Compose con IP fijas (Nginx resuelve el upstream una sola vez; las réplicas llegan a Redis
# por IP para no depender del DNS al reconectar). Cambiar solo si la subred choca con otra red del equipo;
# PROXIES_CONFIABLES de las réplicas toma IP_NGINX.
RED_SUBRED=172.28.0.0/24
IP_NGINX=172.28.0.10
IP_BACKEND_1=172.28.0.11
IP_BACKEND_2=172.28.0.12
IP_REDIS=172.28.0.13
IP_SIMULADOR=172.28.0.14

# --- Funcionalidad 003: suscripciones y pagos (ADR-022, ADR-024, ADR-031) ---

# Pasarela de pagos detrás del puerto PaymentGateway: "simulado" (simulador de desarrollo y pruebas,
# backend/simulador-pagos/, nunca en producción) o "culqi" (proveedor real, solo si R15 se confirma). Pasar a
# producción es cambiar estas variables, no el código.
PAGOS_PROVEEDOR=simulado
# URL de la API de la pasarela. Desde el equipo, el simulador de Compose se publica en el 3100; dentro de
# Compose las réplicas usan su IP fija (IP_SIMULADOR).
PAGOS_URL_BASE=http://localhost:3100
# Llaves de la pasarela y secreto con el que firma sus notificaciones (HMAC-SHA256). Valores SOLO para el
# simulador: con un proveedor real, salen de su panel y nunca se versionan.
PAGOS_LLAVE_PUBLICA=pk_simulador_dev
PAGOS_LLAVE_SECRETA=sk_simulador_dev
PAGOS_SECRETO_FIRMA=whsec_simulador_dev_0123456789
# Adónde vuelve el propietario tras pagar y adónde notifica la pasarela (entra por Nginx, como un proveedor real).
PAGOS_URL_RETORNO=http://localhost:5173/app/suscripcion
PAGOS_URL_NOTIFICACIONES=http://localhost:3000/api/v1/pagos/notificaciones
# Tiempo límite de cada llamada a la pasarela, en milisegundos (de 100 a 10000).
PAGOS_TIEMPO_LIMITE_MS=2000
# Notificaciones de la pasarela aceptadas por IP y minuto (FR-013a; de 1 a 100000).
PAGOS_NOTIFICACIONES_LIMITE_POR_MINUTO=600
# Cuenta a la que el propietario transfiere (FR-019). Datos de prueba.
PAGOS_CUENTA_BANCO=Banco de Prueba
PAGOS_CUENTA_TITULAR=Plataforma Barberías S.A.C.
PAGOS_CUENTA_NUMERO=191-0000000-0-00
PAGOS_CUENTA_CCI=00219100000000000000

# Administrador de la plataforma (ADR-031). Llave AES-256-GCM de los secretos TOTP: 32 bytes en base64.
# Generar una propia con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PLATAFORMA_LLAVE_TOTP=lbHKxTk+JozFdW/boiab5TEu+/KwibmslHzqGFOZxZY=
# Lecturas entre barberías (rol barberias_plataforma: sin BYPASSRLS, solo SELECT por columna y transacciones
# de solo lectura).
DATABASE_URL_PLATAFORMA=postgres://barberias_plataforma:barberias_plataforma_dev@localhost:5433/barberias

# Token de las rutas /control/* del simulador (cambiar modos, decidir pagos sin navegador).
SIMULADOR_TOKEN_CONTROL=control_simulador_dev

# Tareas programadas (ADR-024): vencimiento y conciliación. Intervalo en milisegundos (mínimo 10000; 5 minutos
# por defecto). Con TAREAS_ACTIVAS=false no se programa ninguna tarea en esta réplica.
TAREAS_ACTIVAS=true
TAREAS_INTERVALO_MS=300000
