# Copiar a .env (no versionado). Valores SOLO para desarrollo local.

# Puerto con el que Docker Compose publica PostgreSQL en este equipo (por defecto 5433, para no chocar con
# un PostgreSQL instalado localmente en el 5432). Dentro de la red de Compose la base siempre es db:5432.
DB_PUERTO=5433

# Vite (contenedor frontend) revisa los archivos cada 300 ms porque en Windows y macOS el volumen montado no
# avisa los cambios. En Linux se puede poner false para ahorrar CPU.
VITE_SONDEO=true

# Conexiones a PostgreSQL. La aplicación usa barberias_app (NOBYPASSRLS); las migraciones, barberias_owner.
# Sirven para ejecutar el backend o las migraciones desde el equipo contra la base de Compose (usar el
# mismo puerto que DB_PUERTO). Dentro de Docker Compose se sobrescriben con el host "db" (docker-compose.yml).
DATABASE_URL_APP=postgres://barberias_app:barberias_app_dev@localhost:5433/barberias
DATABASE_URL_OWNER=postgres://barberias_owner:barberias_owner_dev@localhost:5433/barberias
# Vía pública por enlace (catálogo y horarios libres, ADR-021): rol barberias_publico, sin BYPASSRLS y solo
# con SELECT sobre columnas públicas, en transacciones de solo lectura.
DATABASE_URL_PUBLICO=postgres://barberias_publico:barberias_publico_dev@localhost:5433/barberias

# Horarios libres (R08): paso entre horas de inicio, en minutos (divisor de 60, de 5 a 60), y cuántos días
# hacia adelante se puede reservar (de 1 a 90). Propuestas por validar con las barberías.
HORARIOS_PASO_MINUTOS=15
RESERVA_HORIZONTE_DIAS=30

# Firma del token de acceso (ES256, R07).
# Generar un par de claves de desarrollo:
#   openssl ecparam -name prime256v1 -genkey -noout -out privada.pem
#   openssl pkcs8 -topk8 -nocrypt -in privada.pem -out privada-pkcs8.pem
#   openssl ec -in privada.pem -pubout -out publica.pem
# Pegar los PEM en una sola línea reemplazando los saltos de línea por \n.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Claves públicas aceptadas al verificar, por kid (permite rotar claves sin cambiar código).
JWT_PUBLIC_KEYS={"dev-1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}
JWT_ACTIVE_KID=dev-1
JWT_ISSUER=plataforma-barberias
JWT_AUDIENCE=plataforma-barberias-web
ACCESS_TOKEN_TTL_SECONDS=900
# Período de gracia de la rotación del token de renovación (FR-008a, ADR-019): el token anterior se acepta
# una sola vez durante estos segundos tras la rotación (recarga doble, respuesta perdida). De 0 a 30; 0 lo
# desactiva y cualquier reutilización revoca la sesión.
REFRESH_GRACIA_SEGUNDOS=10

# Argon2id (R06): mínimo recomendado por OWASP.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Origen permitido por CORS y URL base para los enlaces de activación.
CORS_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173

# Versiones vigentes de los textos que acepta el propietario al registrarse (FR-005).
TERMS_VERSION=2026-10
PRIVACY_POLICY_VERSION=2026-10

# Registros de barbería permitidos por IP y minuto (POST /barberias).
REGISTRO_LIMITE_POR_MINUTO=10
# Intentos de activación de cuenta por IP y minuto (POST /auth/activar).
ACTIVACION_LIMITE_POR_MINUTO=10

PORT=3000
