# Balanceo local de la API entre dos réplicas del backend (funcionalidad 006, ADR-030; contrato en
# specs/006-escalado-cache-balanceo/contracts/entorno-compose.md §2).
#
# La imagen oficial sustituye ${BACKEND_1} y ${BACKEND_2} al arrancar (envsubst, solo variables definidas):
# - Docker Compose: IP fijas de las réplicas (172.28.0.11:3000 y 172.28.0.12:3000), porque Nginx resuelve
#   los nombres del upstream una sola vez al iniciar;
# - prueba "balanceador": host.testcontainers.internal:{puerto} de cada instancia en proceso.
#
# Comprobación de salud PASIVA (la activa es de Nginx Plus): una réplica con 3 fallos (conexión rechazada o
# sin respuesta en 1 s) dentro de 10 s sale 10 s del reparto; luego se prueba de nuevo y vuelve sola. Con
# max_fails=1, un único fallo pasajero de la réplica sana (equipo cargado) dejaba a Nginx sin réplicas y
# respondía 503 (medido el 2026-10-22); con 3, una réplica caída se detecta igual en milisegundos.
# Solo se reintentan en la otra réplica las solicitudes idempotentes (GET, HEAD): Nginx nunca reenvía un
# POST, PUT, PATCH ni DELETE (comportamiento por defecto desde 1.9.13). Una reserva en vuelo puede fallar y
# el cliente la repite con la misma Idempotency-Key, sin duplicar (002).
#
# Esto no es alta disponibilidad: Nginx, PostgreSQL y Redis siguen siendo únicos (ADR-006, ADR-030).

upstream api {
    server ${BACKEND_1} max_fails=3 fail_timeout=10s;
    server ${BACKEND_2} max_fails=3 fail_timeout=10s;
    keepalive 16;
}

server {
    listen 80;
    server_tokens off;
    charset utf-8;
    # Igual que el límite del cuerpo del backend (16 KB). La subida de comprobantes tiene el suyo (abajo).
    client_max_body_size 16k;

    location /api/ {
        proxy_pass http://api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # IP real del cliente (006 R04): se SOBRESCRIBE con la dirección que ve Nginx; lo que envíe el
        # cliente en estos encabezados se descarta. El backend solo confía en la IP de Nginx.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 1s;
        proxy_send_timeout 30s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_next_upstream_tries 2;
        proxy_next_upstream_timeout 3s;

        # Sin ninguna réplica disponible: error propio en el formato de la API (FR-007).
        error_page 502 503 504 = @sin_servicio;

        # 003 (US3, R05): SOLO la subida del comprobante de una transferencia admite un cuerpo grande. El
        # archivo llega a 5 MB y multipart agrega los límites y los dos campos de texto: 6 MB de margen. El
        # backend vuelve a medir el archivo (multer, 5 MB) y su tipo por los bytes. Cualquier otra ruta sigue
        # con 16 KB. La location anidada hereda los encabezados, los tiempos y el error_page de /api/.
        # Entre comillas: Nginx exige comillas en una expresión regular con llaves.
        location ~ "^/api/v1/suscripcion/pagos/[0-9a-fA-F-]{36}/comprobante$" {
            client_max_body_size 6m;
            proxy_pass http://api;
        }
    }

    location @sin_servicio {
        default_type application/json;
        add_header Retry-After 5 always;
        return 503 '{"codigo":"SERVICIO_NO_DISPONIBLE","mensaje":"El servicio no está disponible en este momento. Intenta de nuevo en unos segundos.","detalles":[]}';
    }

    # Comprobación de salud del propio Nginx (Docker y la prueba de integración).
    location = /nginx-salud {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # El frontend lo sirve Vite (5173); aquí solo se balancea la API.
    location / {
        return 404;
    }
}
